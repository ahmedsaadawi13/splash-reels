# FILE: /.env.example
# SplashReels Environment Configuration

# Application
APP_NAME=SplashReels
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_HOST=localhost
DB_NAME=splashreels
DB_USER=root
DB_PASS=

# Session
SESSION_LIFETIME=7200

# File Upload
MAX_UPLOAD_SIZE=524288000
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,webm,avi

# Storage
STORAGE_PATH=/storage/uploads
